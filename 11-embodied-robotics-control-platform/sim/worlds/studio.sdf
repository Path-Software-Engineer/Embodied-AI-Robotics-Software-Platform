<?xml version="1.0"?>
<sdf version="1.9">
  <world name="studio">
    <gravity>0 0 -9.81</gravity>
    <physics name="deterministic-step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="overhead" type="directional">
      <pose>0 0 4 0 0 0</pose><direction>-0.4 -0.2 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></visual>
      </link>
    </model>
    <include><uri>model://embodied_demo</uri></include>
  </world>
</sdf>
