{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Embodied Robotics Observation Streams",
    "version": "0.1.0",
    "description": "Simulation-only, server-to-browser, read-only full snapshots and loop events."
  },
  "channels": {
    "robotState": {
      "address": "/api/v1/robots/embodied_demo/stream",
      "messages": {
        "RobotStateEnvelope": {
          "payload": {"type": "object", "required": ["type", "mode", "state"], "properties": {
            "type": {"const": "robot-state"},
            "mode": {"const": "simulation"},
            "state": {"$ref": "../schemas/robot-state.v1.schema.json"},
            "database_ready": {"type": "boolean"},
            "dropped_write_samples": {"type": "integer", "minimum": 0}
          }}
        }
      }
    },
    "loopEvents": {
      "address": "/api/v1/robots/embodied_demo/loop-stream",
      "messages": {
        "LoopEventEnvelope": {
          "payload": {"type": "object", "required": ["type", "event"], "properties": {
            "type": {"const": "loop-event"},
            "event": {"$ref": "../schemas/loop-event.v1.schema.json"}
          }}
        }
      }
    }
  },
  "operations": {
    "observeRobotState": {"action": "receive", "channel": {"$ref": "#/channels/robotState"}},
    "observeLoopEvents": {"action": "receive", "channel": {"$ref": "#/channels/loopEvents"}}
  }
}
